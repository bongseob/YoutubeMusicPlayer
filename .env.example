MYSQL_PORT=3307
MYSQL_DATABASE=tj_karaoke
MYSQL_USER=karaoke
MYSQL_PASSWORD=replace-with-a-long-db-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
# At least 24 characters. Never put this in a VITE_ variable.
ADMIN_TOKEN=replace-with-a-random-admin-token-at-least-24-characters
PORT=3001
# Production behind a local Apache: HOST=127.0.0.1, PORT=3004, TRUST_PROXY=loopback
HOST=0.0.0.0
TRUST_PROXY=
# Optional: needed only for indexing official channel videos in bulk.
YOUTUBE_DATA_API_KEY=
