# Server-only template. Copy into the project root as .env and replace placeholders.
NODE_ENV=production
HOST=127.0.0.1
PORT=3004
TRUST_PROXY=loopback

# Docker Compose DB: independent from Bitnami's existing MySQL/MariaDB.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=tj_karaoke
MYSQL_USER=karaoke
MYSQL_PASSWORD=replace-with-a-new-server-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
ADMIN_TOKEN=replace-with-a-random-server-admin-token-at-least-24-characters

# Optional: used by manual metadata sync, not by normal playback.
YOUTUBE_DATA_API_KEY=
